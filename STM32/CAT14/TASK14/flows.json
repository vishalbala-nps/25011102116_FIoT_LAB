    {
        "id": "267b50a3613728ab",
        "type": "function",
        "z": "192b09c1d46de512",
        "name": "Rack vs outside",
        "func": "const o = flow.get(\"outside\");\nconst t = Number(msg.payload.t);\nif (!o || !Number.isFinite(t)) return null;\n\nconst diff = t - o.t;\nlet text = Math.abs(diff) < 0.5\n    ? \"Rack is about the same as outside\"\n    : `Rack is ${Math.abs(diff).toFixed(1)} °C ${diff > 0 ? \"warmer\" : \"cooler\"} than outside`;\n\n// Pressure check, once the BME280 sends \"p\"\nconst p = Number(msg.payload.p);\nif (Number.isFinite(p) && o.p) {\n    text += ` · Pressure ${p.toFixed(1)} hPa (outside ${o.p} hPa)`;\n}\n\nreturn { payload: text };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
