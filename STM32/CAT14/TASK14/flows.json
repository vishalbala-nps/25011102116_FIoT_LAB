        "head": "",
        "format": "<template>\n  <div v-if=\"msg?.payload?.ok === undefined\" class=\"rack-status rack-waiting\">\n    <span class=\"rack-status-icon\">…</span>\n    <div>\n      <div class=\"rack-status-title\">Waiting for data</div>\n      <div class=\"rack-status-text\">No status received yet.</div>\n    </div>\n  </div>\n\n  <div v-else-if=\"msg.payload.ok\" class=\"rack-status rack-ok\">\n    <span class=\"rack-status-icon\">✓</span>\n    <div>\n      <div class=\"rack-status-title\">Everything is fine</div>\n      <div class=\"rack-status-text\">Temperature is within the safe range.</div>\n    </div>\n  </div>\n\n  <div v-else class=\"rack-status rack-alert\">\n    <span class=\"rack-status-icon\">⚠</span>\n    <div>\n      <div class=\"rack-status-title\">Temperature high</div>\n      <div class=\"rack-status-text\">Action needed: check the cooling and airflow.</div>\n    </div>\n  </div>\n</template>\n\n<style>\n.rack-status {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: 16px 20px;\n  border-radius: 10px;\n  color: white;\n}\n.rack-ok { background: #2b8a3e; }\n.rack-alert { background: #c92a2a; }\n.rack-waiting { background: #5c6670; }\n.rack-status-icon {\n  font-size: 32px;\n  font-weight: 700;\n  line-height: 1;\n}\n.rack-status-title {\n  font-size: 20px;\n  font-weight: 700;\n}\n.rack-status-text { font-size: 14px; }\n</style>",
