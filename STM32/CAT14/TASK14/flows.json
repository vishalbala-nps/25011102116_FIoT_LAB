    {
        "id": "5f5baf04ef9768d1",
        "type": "function",
        "z": "192b09c1d46de512",
        "name": "function 4",
        "func": "const LIMIT = 30;      // High above this temperature\nconst CLEAR_AT = 29;   // Clear at or below this temperature\nconst REQUIRED = 3;    // Consecutive high readings needed\n\nconst temp = Number(msg.payload.t);\nif (Number.isNaN(temp)) return null;   // Ignore bad readings\n\nlet count = context.get(\"count\") || 0;\nlet alert = context.get(\"alert\") || false;\n\ncount = temp > LIMIT ? count + 1 : 0;\n\nif (count >= REQUIRED) {\n    alert = true;\n} else if (temp <= CLEAR_AT) {\n    alert = false;\n}\n\ncontext.set(\"count\", count);\ncontext.set(\"alert\", alert);\n\nnode.status({\n    fill: alert ? \"red\" : \"green\",\n    shape: \"dot\",\n    text: `${temp}°C, count: ${count}`\n});\n\nmsg.payload = alert;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 580,
