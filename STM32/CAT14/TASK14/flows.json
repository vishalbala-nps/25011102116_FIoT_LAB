    {
        "id": "51e90989d8f07590",
        "type": "ui-template",
        "z": "192b09c1d46de512",
        "group": "ae805b69e83b5ec9",
        "page": "",
        "ui": "",
        "name": "Outside card",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div v-if=\"msg?.payload?.t === undefined\" class=\"ow-card\">Waiting for weather…</div>\n  <div v-else class=\"ow-card\">\n    <div class=\"ow-head\">\n      <img v-if=\"msg.payload.icon\" class=\"ow-icon\" alt=\"\"\n           :src=\"'https://openweathermap.org/img/wn/' + msg.payload.icon + '@2x.png'\">\n      <div>\n        <div class=\"ow-temp\">{{ msg.payload.t.toFixed(1) }} °C</div>\n        <div class=\"ow-desc\">{{ msg.payload.desc }}</div>\n      </div>\n    </div>\n    <div class=\"ow-grid\">\n      <div><span>Feels like</span><b>{{ msg.payload.feels.toFixed(1) }} °C</b></div>\n      <div><span>Humidity</span><b>{{ msg.payload.h }} %</b></div>\n      <div><span>Pressure</span><b>{{ msg.payload.p }} hPa</b></div>\n      <div><span>Wind</span><b>{{ ((msg.payload.wind || 0) * 3.6).toFixed(0) }} km/h</b></div>\n    </div>\n    <div class=\"ow-foot\">{{ msg.payload.place }} · updated {{ msg.payload.updated }}</div>\n  </div>\n</template>\n\n<style>\n.ow-card {\n  padding: 16px;\n  border-radius: 10px;\n  background: #0b7285;\n  color: white;\n}\n.ow-head { display: flex; align-items: center; gap: 8px; }\n.ow-icon { width: 64px; height: 64px; }\n.ow-temp { font-size: 32px; font-weight: 700; line-height: 1.1; }\n.ow-desc { font-size: 14px; text-transform: capitalize; }\n.ow-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 8px;\n  margin-top: 12px;\n}\n.ow-grid div { display: flex; flex-direction: column; }\n.ow-grid span { font-size: 12px; opacity: 0.85; }\n.ow-grid b { font-size: 16px; }\n.ow-foot { margin-top: 10px; font-size: 12px; opacity: 0.85; }\n</style>",
        "storeOutMessages": true,
