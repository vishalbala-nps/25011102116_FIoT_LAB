        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 1000,
        "y": 900,
        "wires": [
            []
        ]
    },
    {
        "id": "a1873660b7075f3c",
        "type": "function",
        "z": "192b09c1d46de512",
        "name": "Parse weather",
        "func": "const w = msg.payload;\nif (msg.statusCode !== 200 || !w || !w.main) {\n    node.status({ fill: \"red\", shape: \"ring\", text: (w && w.message) || `HTTP ${msg.statusCode}` });\n    return null;\n}\n\nconst outside = {\n    t: w.main.temp,\n    feels: w.main.feels_like,\n    h: w.main.humidity,\n    p: w.main.pressure,\n    wind: w.wind ? w.wind.speed : 0,                     // m/s\n    desc: w.weather && w.weather[0] ? w.weather[0].description : \"\",\n    icon: w.weather && w.weather[0] ? w.weather[0].icon : \"\",\n    place: w.name || \"\",\n    updated: new Date(w.dt * 1000).toLocaleTimeString(\"en-IN\", {\n        timeZone: \"Asia/Kolkata\", hour: \"2-digit\", minute: \"2-digit\"\n    })\n};\nflow.set(\"outside\", outside);   // Used by \"Rack vs outside\"\n\nnode.status({ fill: \"green\", shape: \"dot\", text: `${outside.t} °C, ${outside.desc}` });\n\nreturn [\n    { payload: outside },                            // Output 1: outside card\n    { topic: \"Outside\", payload: { t: outside.t } }  // Output 2: chart line\n];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 920,
