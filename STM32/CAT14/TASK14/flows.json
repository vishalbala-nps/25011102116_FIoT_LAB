    {
        "id": "eee714a1d708813c",
        "type": "function",
        "z": "192b09c1d46de512",
        "name": "Parse forecast",
        "func": "const f = msg.payload;\nif (msg.statusCode !== 200 || !f || !Array.isArray(f.list) || f.list.length === 0) {\n    node.status({ fill: \"red\", shape: \"ring\", text: (f && f.message) || `HTTP ${msg.statusCode}` });\n    return null;\n}\n\nconst next = f.list.slice(0, 8);   // Next 24 hours, in 3-hour steps\nlet hottest = next[0];\nfor (const e of next) {\n    if (e.main.temp_max > hottest.main.temp_max) hottest = e;\n}\nconst rain = Math.round(Math.max(...next.map(e => e.pop || 0)) * 100);\nconst max = hottest.main.temp_max;\nconst time = new Date(hottest.dt * 1000).toLocaleString(\"en-IN\", {\n    timeZone: \"Asia/Kolkata\", weekday: \"short\", hour: \"numeric\"\n});\n\nconst HOT = Number(env.get(\"HOT_DAY\")) || 34;\nlet level = \"ok\";\nlet advice = \"No weather concerns in the next 24 hours.\";\nif (max >= HOT) {\n    level = \"hot\";\n    advice = \"Hot period ahead: check the cooling before then.\";\n} else if (rain >= 60) {\n    level = \"rain\";\n    advice = \"Rain likely: keep doors closed to limit humidity.\";\n}\n\nnode.status({ fill: level === \"ok\" ? \"green\" : \"yellow\", shape: \"dot\", text: `max ${max} °C, rain ${rain}%` });\nreturn { payload: { max: max.toFixed(1), time, rain, level, advice } };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 1000,
        "wires": [
            []
        ]
    },
